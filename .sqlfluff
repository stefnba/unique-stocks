[sqlfluff]
dialect = duckdb
templater = jinja
max_line_length = 120
sql_file_exts = .sql
exclude_rules = AL04, AL09, AM04, AM05, AM06, CP02, ST06, ST11
large_file_skip_byte_limit = 0

[sqlfluff:templater:jinja]
apply_dbt_builtins = True

[sqlfluff:templater:jinja:macros]
surrogate_key = {% macro surrogate_key(fields) -%}md5(concat_ws('||', {%- for field in fields -%}CAST({{ field }} AS VARCHAR){% if not loop.last %}, {% endif %}{%- endfor -%})){%- endmacro %}
param = {% macro param() -%}1{%- endmacro %}

[sqlfluff:templater:jinja:context]
instrument_universe_relation = silver.int_latest_instrument_universe
trading_day_relation = silver.int_exchange_trading_day
instrument_day_coverage_relation = silver.int_eod_price_instrument_day_coverage
terminal_coverage_relation = silver.int_eod_price_backfill_terminal_coverage
status_relation = silver.int_eod_price_exchange_day_status
pair_predicates = provider_exchange_code = 'US' AND bar_date = DATE '2026-05-01'
code_placeholders = 'US'
from_date_filter = True
to_date_filter = True
universe_relation = silver.int_fundamental_ingestion_universe
exchange_filter = True
exchange_placeholders = 'US'
skip_completed = True
completion_relation = silver.int_fundamental_document_completion
limit_filter = True

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4
implicit_indents = require
indented_on_contents = false

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:layout.newlines]
maximum_empty_lines_inside_statements = 1
maximum_empty_lines_between_statements = 1

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

[sqlfluff:rules:references.qualification]
subqueries_ignore_external_references = true

[sqlfluff:rules:references.consistent]
force_enable = true

[sqlfluff:rules:references.keywords]
ignore_words = comments,domain,shares,year

[sqlfluff:layout:type:comma]
line_position = trailing

[sqlfluff:layout:type:limit_clause]
keyword_line_position = leading

[sqlfluff:layout:type:comparison_operator]
spacing_before = single:inline
spacing_after = single:inline

[sqlfluff:layout:type:assignment_operator]
spacing_before = single:inline
spacing_after = single:inline
