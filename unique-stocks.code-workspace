{
  "folders": [
    {
      "path": ".",
      "name": "Root"
    },
    {
      "path": "./services/data_platform",
      "name": "Data Platform"
    },
    {
      "path": "./services/data_platform/orchestration",
      "name": "Data Orchestration"
    },
    {
      "path": "./services/spark",
      "name": "Spark Cluster"
    },
    {
      "path": "./services/pipelines",
      "name": "Pipelines"
    }
  ],
  "settings": {
    "files.associations": {
      "*.sql": "jinja-sql"
    },
    "vscode-postgres.prettyPrintJSONfields": true,
    "[postgres]": {
      "editor.defaultFormatter": "bradymholt.pgformatter"
    },
    "pgFormatter.placeholder": "\\%\\([a-zA-Z]+\\)[a-zA-Z]|\\$[a-zA-Z]+|\\$\\<[a-zA-Z]+>|\\$\\<[a-zA-Z]+\\:[a-zA-Z]+>",
    "python.languageServer": "Pylance",
    "notebook.formatOnSave.enabled": true,
    "mypy-type-checker.importStrategy": "fromEnvironment",
    "mypy-type-checker.path": ["mypy"],
    "mypy-type-checker.args": ["--enable-incomplete-feature=NewGenericSyntax"]
  }
}
