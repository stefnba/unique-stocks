# Data provider
EODHD_API_KEY=your_key_here

# MotherDuck — leave blank to use local DuckDB in development
MOTHERDUCK_TOKEN=
LAKE_NAME=unique_stocks
# Optional local DuckDB path. When unset, Settings and Make derive {LAKE_NAME}.duckdb.
# LOCAL_LAKE_PATH=unique_stocks.duckdb

# Optional dashboard-specific read-only MotherDuck token.
# When set, the Streamlit dashboard uses this instead of MOTHERDUCK_TOKEN.
DASHBOARD_MOTHERDUCK_TOKEN=

# dbt direct CLI defaults. App flows derive target/path/lake name from settings.
DBT_TARGET=dev
# Optional direct dbt CLI DuckDB path. Make and app flows set this from the resolved local lake path.
# DBT_DUCKDB_PATH=unique_stocks.duckdb
# LAKE_NAME and LOCAL_LAKE_PATH are also set by app flows for dbt.

# S3 (optional for v1 — cold archival only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Prefect — point to self-hosted server (docker-compose) or Prefect Cloud
# Local dev without Docker:
PREFECT_API_URL=http://localhost:4200/api
# Inside docker-compose: PREFECT_API_URL=http://pipelines-server:4200/api
# Coolify production:     PREFECT_API_URL=https://prefect.yourdomain.com/api
PREFECT_UI_URL=http://localhost:4200
# Default worker concurrency is serialized to protect local DuckDB and provider quotas.
PREFECT_WORKER_LIMIT=1
# Global lake/provider limits are registered by setup from code defaults.
# Keep false for local/bootstrap runs; set true after managed environments have registered limits.
PREFECT_GLOBAL_LIMITS_FAIL_CLOSED=false
# Reserved for planned Prefect notification support; current automations use no-op actions.
PREFECT_NOTIFICATION_BLOCK_ID=

# Working directory for prefect.yaml pull step (local dev: . / Docker: /app)
PREFECT_WORK_DIR=.

# App
# Use docker_dev inside docker-compose. If MOTHERDUCK_TOKEN is set, app and dbt flows target MotherDuck.
ENVIRONMENT=dev

# Logging
# auto uses readable console logs outside prod and JSON logs in prod.
# Set these before importing pipeline modules in local scripts; Docker compose
# sets them before the worker imports app code.
PIPELINE_LOG_LEVEL=INFO
PIPELINE_LOG_FORMAT=auto
PREFECT_LOGGING_EXTRA_LOGGERS=core,domains,providers,config,scripts
PREFECT_LOGGING_LOG_PRINTS=False
GIT_SHA=

# Optional Docker health monitor freshness checks.
# Example: OPERATIONAL_HEALTH_RECENT_DOMAINS=eod_price,fundamental
OPERATIONAL_HEALTH_RECENT_DOMAINS=
OPERATIONAL_HEALTH_RECENT_HOURS=36
OPERATIONAL_HEALTH_STALE_RUNNING_HOURS=2
# auto uses normal connections for MotherDuck tokens and read-only connections for local DuckDB.
# Set true only when using a MotherDuck read-scaling token.
OPERATIONAL_HEALTH_LAKE_READ_ONLY=auto
