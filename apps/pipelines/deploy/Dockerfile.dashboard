FROM python:3.14-slim

ARG GIT_SHA=""

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_CACHE_DIR=/tmp/uv-cache \
    GIT_SHA=${GIT_SHA}

WORKDIR /app

RUN pip install --no-cache-dir uv

# Python 3.14 wheels are not available for every dependency yet.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libffi-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./

RUN uv sync --no-dev --frozen --extra dashboard --no-install-project

COPY . .

RUN uv sync --no-dev --frozen --extra dashboard

RUN useradd --create-home --uid 10001 app \
    && mkdir -p /app/lake-data \
    && chown -R app:app /app

USER app

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=60s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=5).read()"

CMD ["uv", "run", "--no-dev", "--frozen", "--extra", "dashboard", "streamlit", "run", "dashboard/app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
